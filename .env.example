# Local development only. Replace every CHANGE_ME value before starting services.
# Compose reads this file after copying to .env. Spring Boot does not load .env automatically.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=frameflow
DB_USERNAME=frameflow
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
DB_POOL_SIZE=5
SERVER_PORT=8080
FRONTEND_PORT=3000
APP_LOG_LEVEL=INFO
