# Local development only. Replace every CHANGE_ME value before starting services.
# Compose reads this file after copying to .env. Spring Boot does not load .env automatically.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=frameflow
DB_USERNAME=frameflow
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD
DB_POOL_SIZE=5
SERVER_PORT=8080
FRONTEND_PORT=3000
# Next server runtime only; pass explicitly when starting frontend in another terminal.
# Compose backend hostname wiring remains part of IP-15.
JAVA_API_ORIGIN=http://127.0.0.1:8080
APP_LOG_LEVEL=INFO
# Explicit loopback HTTP setting. Set true for browser-facing HTTPS, even behind Next.
SESSION_COOKIE_SECURE=false
# Only needed for explicit initialization of missing presets; no usable default passwords.
DEMO_A_PASSWORD=
DEMO_B_PASSWORD=

# Local backend input files; IP-15 will wire a persistent container volume.
ASSET_STORAGE_ROOT=./data/assets

# In-memory background execution; no restart recovery.
TASK_WORKER_COUNT=2
TASK_QUEUE_CAPACITY=64
# Development-only HTTP simulation controls; omitted settings use 1000 ms per stage.
MOCK_CONTROLS_ENABLED=false
