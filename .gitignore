logs/
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# IDE-local state; share useful VS Code project configuration
.idea/
*.iml
*.ipr
*.iws
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
.history/
